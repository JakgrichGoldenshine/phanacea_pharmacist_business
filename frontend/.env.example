# Base URL of the API, including the /api suffix and with no trailing slash.
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:4000/api
# Production (set this in the Vercel project's Environment Variables,
# not in this file):
#   VITE_API_BASE_URL=https://phanacea-api.vercel.app/api
#
# Note: anything prefixed with VITE_ is inlined into the browser bundle at
# build time, so never put a secret here.
VITE_API_BASE_URL=http://localhost:4000/api

# Reveals the hidden demo-login trigger on /login (click the title 5x).
# Only takes effect if the backend also has DEMO_LOGIN_ENABLED=true — this
# flag alone doesn't grant access, it just shows the button. Presentation
# deployments only; turn back off afterwards.
VITE_ENABLE_DEMO_LOGIN=false
