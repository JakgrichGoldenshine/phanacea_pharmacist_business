# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Allowed browser origin(s) for CORS. Accepts a comma-separated list so one
# deployment can serve local development and production at the same time:
#   FRONTEND_URL=http://localhost:5173,https://phanacea.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional regex matching Vercel preview deployments (they get a fresh
# hostname per pull request). Leave empty to allow none.
#   FRONTEND_PREVIEW_PATTERN=^https://phanacea-[a-z0-9-]+\.vercel\.app$
FRONTEND_PREVIEW_PATTERN=

# ── Supabase (Database on-cloud) ───────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Auth ────────────────────────────────────────────────
# REQUIRED in production — the app refuses to boot with the default value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Rate limits ─────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Requests per minute per IP across the whole API (the chat screens poll).
API_RATE_LIMIT_MAX=300

# ── Checkout accountability ─────────────────────────────
# Every online order records a staff_id for the audit trail
# (stock_movements). This names the preferred account; if it is missing or
# inactive the server falls back to an active owner, so checkout keeps
# working either way.
CHECKOUT_STAFF_USERNAME=admin

# ── Admin bootstrap (used by `npm run create-admin`) ────
# Safe to leave blank and pass --username / --password on the command line.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=ผู้ดูแลระบบ (Admin)
ADMIN_ROLE=owner

# ── Demo login (presentations only) ─────────────────────
# Adds a password-less POST /api/auth/demo-login that logs straight in as
# the seeded "admin" or "staff" account, behind a hidden trigger on the
# /login page (also needs VITE_ENABLE_DEMO_LOGIN=true in frontend/.env).
# Leave unset/false everywhere except a throwaway presentation deployment
# with mock data — this is an intentional auth bypass. Turn it back off
# afterwards.
DEMO_LOGIN_ENABLED=false
